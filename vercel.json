{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "maxDuration": 60
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "crons": [
    { "path": "/api/cron/check-expired", "schedule": "0 0 * * *" },
    { "path": "/api/cron/check-expired", "schedule": "0 6 * * *" },
    { "path": "/api/cron/check-expired", "schedule": "0 12 * * *" },
    { "path": "/api/cron/check-expired", "schedule": "0 18 * * *" }
  ]
}
