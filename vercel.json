{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "functions": {
    "server.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/check-expired",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/check-expired",
      "schedule": "0 12 * * *"
    }
  ]
}
